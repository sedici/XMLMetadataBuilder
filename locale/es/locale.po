msgid "plugins.generic.XMLMetadataBuilder.displayName"
msgstr "XML Metadata Builder"

msgid "plugins.generic.XMLMetadataBuilder.description"
msgstr "Enriquece automáticamente el JATS de cada publicación con los metadatos de OJS (perfil SciELO/SPS) al subirlo, al publicar y al crear una versión nueva."

msgid "plugins.generic.XMLMetadataBuilder.log.enriched.upload"
msgstr "El JATS de la publicación se enriqueció con los metadatos de OJS al subirlo."

msgid "plugins.generic.XMLMetadataBuilder.log.enriched.publish"
msgstr "El JATS de la publicación se enriqueció con los metadatos definitivos al publicar."

msgid "plugins.generic.XMLMetadataBuilder.log.enriched.version"
msgstr "El JATS se copió a la versión nueva con sus archivos dependientes y se enriqueció."
