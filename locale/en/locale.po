msgid "plugins.generic.XMLMetadataBuilder.displayName"
msgstr "XML Metadata Builder"

msgid "plugins.generic.XMLMetadataBuilder.description"
msgstr "Enriches JATS XML files with publication metadata to improve content and structure."

msgid "plugins.generic.XMLMetadataBuilder.publicationStatement"
msgstr "Publication Statement"

msgid "plugins.generic.XMLMetadataBuilder.publicationStatement.description"
msgstr "Add a publication statement that you would like to appear on every publication's landing page."

msgid "plugins.generic.XMLMetadataBuilder.publication.jats.fulltext"
msgstr "XML Enricher"

msgid "plugins.generic.XMLMetadataBuilder.publication.jats.description"
msgstr "Select an XML file from production to enrich with metadata from the submission. A new enriched XML file will be generated."

msgid "plugins.generic.XMLMetadataBuilder.suffix"
msgstr "File Suffix"

msgid "plugins.generic.XMLMetadataBuilder.suffixDescription"
msgstr "Suffix to append to the filename of the enriched XML file (e.g., '-enriched' will create 'article-enriched.xml')"

msgid "plugins.generic.XMLMetadataBuilder.publication.jats.showFront"
msgstr "Show Front"

msgid "plugins.generic.XMLMetadataBuilder.publication.jats.generate"
msgstr "Generate Enriched XML"

msgid "plugins.generic.XMLMetadataBuilder.noXmlFiles"
msgstr "No XML files found in production ready files."

msgid "plugins.generic.XMLMetadataBuilder.selectXmlFile"
msgstr "Select XML File"

msgid "plugins.generic.XMLMetadataBuilder.selectXmlFile.description"
msgstr "Choose an XML file from the production-ready files to enrich."

msgid "plugins.generic.XMLMetadataBuilder.overwrite"
msgstr "Overwrite Existing File"

msgid "plugins.generic.XMLMetadataBuilder.overwrite.confirm"
msgstr "Overwrite the existing file instead of creating a new one"

msgid "plugins.generic.XMLMetadataBuilder.enrichmentSuccessNewFile"
msgstr "Enriched XML file generated successfully!"

msgid "plugins.generic.XMLMetadataBuilder.enrichmentError"
msgstr "Error enriching XML file"

msgid "plugins.generic.XMLMetadataBuilder.noFileSelected"
msgstr "Please select an XML file before proceeding"

msgid "plugins.generic.XMLMetadataBuilder.fileNotFound"
msgstr "The selected file was not found"

msgid "plugins.generic.XMLMetadataBuilder.createGalley"
msgstr "Submit to Galleys"

msgid "plugins.generic.XMLMetadataBuilder.createGalley.confirm"
msgstr "Create a copy in Galleys (if unchecked, the file will only be created in Production)"
