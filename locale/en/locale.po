msgid "plugins.generic.XMLMetadataBuilder.displayName"
msgstr "XML Metadata Builder"

msgid "plugins.generic.XMLMetadataBuilder.description"
msgstr "Automatically enriches each publication's JATS with OJS metadata (SciELO/SPS profile) on upload, on publication and when a new version is created."

msgid "plugins.generic.XMLMetadataBuilder.log.enriched.upload"
msgstr "The publication JATS was enriched with OJS metadata on upload."

msgid "plugins.generic.XMLMetadataBuilder.log.enriched.publish"
msgstr "The publication JATS was enriched with the final metadata on publication."

msgid "plugins.generic.XMLMetadataBuilder.log.enriched.version"
msgstr "The JATS was copied to the new version with its dependent files and enriched."

msgid "plugins.generic.XMLMetadataBuilder.log.enriched.edit"
msgstr "The publication JATS was updated after a metadata change."
